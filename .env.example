# PostgreSQL; these credentials match compose.yaml
DATABASE_URL="postgresql://root:mysecretpassword@localhost:5432/local"

# App URL and Better Auth signing key (generate your own key)
ORIGIN="http://localhost:5173"
BETTER_AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters"

# Optional: original course CSV directory; defaults to ./data demo fixtures
# SIM_DATA_DIR="/absolute/path/to/course-data"

# Optional: external simulator HTTP ingestion (disabled when token is empty)
MOWER_INGEST_TOKEN=""
# Generate a new UUID for each independent external simulator run
MOWER_EXTERNAL_RUN_ID=""

# Optional development overrides (bun run dev always uses Docker PostgreSQL)
# DEV_DB_PORT="5432"
# DEV_ORIGIN="http://localhost:5173"
