// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── App Models ──────────────────────────────────────────────────────────────

model Task {
  id       Int    @id @default(autoincrement())
  title    String
  priority Int    @default(1)

  @@map("task")
}

// ─── Better Auth Models ───────────────────────────────────────────────────────

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// Simulator IDs are scoped to a run; a restart cannot overwrite previous history.
model SimulationRun {
  id         String          @id @default(uuid()) @db.Uuid
  created_at DateTime        @default(now())
  machine_id String          @default("00000000-0000-4000-8000-000000000002") @db.Uuid
  cycle_id   String?         @db.Uuid
  machine    Machine         @relation(fields: [machine_id], references: [id])
  cycle      MowingCycle?    @relation(fields: [cycle_id], references: [id])
  source     String
  sessions   MowingSession[]
  zones      Zone[]

  @@index([machine_id, created_at])
  @@map("simulation_run")
}

model MowingSession {
  id                   String        @id @default(uuid()) @db.Uuid
  run_id               String        @db.Uuid
  session_id           Int
  start_time           DateTime
  end_time             DateTime?
  weather              String
  bearing_wear         Float
  duration_min         Int?
  battery_start_pct    Float?
  battery_end_pct      Float?
  rows                 Int?
  area_covered_m2      Float?
  mean_motor_current_a Float?
  peak_motor_current_a Float?
  anomaly_rows         Int?
  sessions_to_failure  Int?
  ended_with_error     String?
  run                  SimulationRun @relation(fields: [run_id], references: [id], onDelete: Cascade)
  readings             Reading[]
  events               MowerEvent[]

  @@unique([run_id, session_id])
  @@index([run_id, start_time, id])
  @@index([start_time, id])
  @@map("mowing_session")
}

model Zone {
  id                  String        @id @default(uuid()) @db.Uuid
  run_id              String        @db.Uuid
  zone_id             Int
  area_m2             Float
  grass_density       Float
  avg_slope_deg       Float
  avg_motor_current_a Float
  avg_speed_mps       Float
  time_spent_s        Int
  anomaly_count       Int
  obstacle_events     Int
  coverage_pct        Float
  run                 SimulationRun @relation(fields: [run_id], references: [id], onDelete: Cascade)
  readings            Reading[]
  events              MowerEvent[]

  @@unique([run_id, zone_id])
  @@map("zone")
}

model Reading {
  id              String        @id @default(uuid()) @db.Uuid
  session_ref     String        @db.Uuid
  zone_ref        String        @db.Uuid
  received_at     DateTime?     @default(now())
  timestamp       DateTime
  session_id      Int
  zone_id         Int
  latitude        Float
  longitude       Float
  speed_mps       Float
  heading_deg     Float
  mode            MowerMode
  battery_pct     Float
  voltage_v       Float
  current_a       Float
  battery_temp_c  Float
  motor_current_a Float
  motor_rpm       Int
  slope_deg       Float
  grass_load      Float
  ambient_temp_c  Float
  humidity_pct    Float
  rain            Boolean
  is_anomaly      Boolean
  session         MowingSession @relation(fields: [session_ref], references: [id], onDelete: Cascade)
  zone            Zone          @relation(fields: [zone_ref], references: [id], onDelete: Cascade)

  @@unique([session_ref, timestamp])
  @@index([session_ref, timestamp, id])
  @@index([timestamp, id])
  @@index([zone_ref, timestamp])
  @@map("reading")
}

model MowerEvent {
  id          String         @id @default(uuid()) @db.Uuid
  session_ref String         @db.Uuid
  zone_ref    String         @db.Uuid
  received_at DateTime?      @default(now())
  timestamp   DateTime
  session_id  Int
  zone_id     Int
  latitude    Float
  longitude   Float
  event_type  MowerEventType
  error_code  String?
  session     MowingSession  @relation(fields: [session_ref], references: [id], onDelete: Cascade)
  zone        Zone           @relation(fields: [zone_ref], references: [id], onDelete: Cascade)

  @@unique([session_ref, timestamp, event_type])
  @@index([session_ref, timestamp, id])
  @@index([timestamp, id])
  @@index([zone_ref, timestamp])
  @@map("mower_event")
}

enum MowerMode {
  mowing
  returning
  charging
}

enum MowerEventType {
  obstacle_detected
  bump
  high_load
  stall
  unexpected_stop
  lift
  tilt
}

model Property {
  id       String         @id @default(uuid()) @db.Uuid
  name     String
  machines Machine[]
  zones    PropertyZone[]
  cycles   MowingCycle[]

  @@map("property")
}

model Machine {
  id               String            @id @default(uuid()) @db.Uuid
  property_id      String            @db.Uuid
  name             String
  token_hash       String?           @unique
  last_received_at DateTime?
  last_observed_at DateTime?
  property         Property          @relation(fields: [property_id], references: [id])
  receipts         DeliveryReceipt[]
  runs             SimulationRun[]
  summaries        DailySummary[]
  progress         ZoneProgress[]

  @@index([property_id, id])
  @@map("machine")
}

model PropertyZone {
  id          String         @id @default(uuid()) @db.Uuid
  property_id String         @db.Uuid
  zone_id     Int
  area_m2     Float
  property    Property       @relation(fields: [property_id], references: [id])
  progress    ZoneProgress[]

  @@unique([property_id, zone_id])
  @@map("property_zone")
}

model MowingCycle {
  id           String          @id @default(uuid()) @db.Uuid
  property_id  String          @db.Uuid
  started_at   DateTime        @default(now())
  completed_at DateTime?
  historical   Boolean         @default(false)
  property     Property        @relation(fields: [property_id], references: [id])
  runs         SimulationRun[]
  progress     ZoneProgress[]

  @@index([property_id, started_at])
  @@map("mowing_cycle")
}

model ZoneProgress {
  id           String       @id @default(uuid()) @db.Uuid
  cycle_id     String       @db.Uuid
  machine_id   String       @db.Uuid
  zone_ref     String       @db.Uuid
  coverage_pct Float
  observed_at  DateTime?
  cycle        MowingCycle  @relation(fields: [cycle_id], references: [id])
  machine      Machine      @relation(fields: [machine_id], references: [id])
  zone         PropertyZone @relation(fields: [zone_ref], references: [id])

  @@unique([cycle_id, machine_id, zone_ref])
  @@map("zone_progress")
}

model DailySummary {
  machine_id        String   @db.Uuid
  day               DateTime @db.Date
  sample_count      Int
  anomaly_count     Int
  motor_current_sum Float
  motor_current_max Float
  temperature_max   Float
  battery_sum       Float
  battery_min       Float
  machine           Machine  @relation(fields: [machine_id], references: [id])

  @@id([machine_id, day])
  @@map("daily_summary")
}

model DeliveryReceipt {
  machine_id   String    @db.Uuid
  message_id   String    @db.Uuid
  run_id       String    @db.Uuid
  payload_hash String
  received_at  DateTime  @default(now())
  captured_at  DateTime?
  machine      Machine   @relation(fields: [machine_id], references: [id], onDelete: Cascade)

  @@id([machine_id, message_id])
  @@map("delivery_receipt")
}
